{
  "name": "tableloom",
  "version": "0.1.2",
  "private": true,
  "description": "Design, playtest, and print tabletop games.",
  "license": "Apache-2.0",
  "author": "Tableloom contributors",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop.mjs",
    "start": "electron .",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "cli": "tsx src/cli.ts",
    "collaboration": "tsx server/index.ts",
    "test:desktop": "tsx scripts/create-print-fixtures.ts && node scripts/run-desktop-check.mjs",
    "test:performance": "tsx scripts/check-projects.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "format": "prettier --write src desktop server scripts tests",
    "format:check": "prettier --check src desktop server scripts tests",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/source-sans-3": "^5.2.8",
    "@fontsource/stardos-stencil": "^5.3.0",
    "@lucide/vue": "^1.41.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "fast-xml-parser": "^5.3.8",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "jsep": "^1.4.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "semver": "^7.8.5",
    "vue": "^3.5.42",
    "ws": "^8.19.0",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.13",
    "@types/papaparse": "^5.5.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "7z-bin": "^0.0.8",
    "7zip-bin": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1",
    "prettier": "^3.6.2",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.2.5"
  },
  "build": {
    "appId": "org.tableloom.studio",
    "productName": "Tableloom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE",
      "README.md",
      "docs/THIRD_PARTY.md",
      "docs/font-licenses/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png"
    },
    "artifactName": "Tableloom-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "Tableloom-${version}-win-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Tableloom-${version}-win-${arch}-Portable.${ext}"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oipoistar/tableloom.git"
  },
  "homepage": "https://github.com/oipoistar/tableloom",
  "bugs": {
    "url": "https://github.com/oipoistar/tableloom/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
